# Copy this file to `.env` and fill in your keys.
# Get a free Groq key:  https://console.groq.com/keys
# Get a free FRED key:  https://fredaccount.stlouisfed.org/apikeys

GROQ_API_KEY=your_groq_key_here
FRED_API_KEY=your_fred_key_here

# Anthropic (Claude Haiku 4.5 for synthesis — best quality, small $ cost)
ANTHROPIC_API_KEY=

# Cerebras (free, same Llama 3.3 70B as Groq but 10x daily quota)
# Get a free key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Hard daily budget in USD. Set to 0 to disable paid API usage entirely.
# When hit, the system falls back to Cerebras (free) → Groq (free).
DAILY_USD_BUDGET=1.00

# Optional (only if you add Telegram alerts later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
